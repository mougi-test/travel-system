# Энэ файлыг .env нэрээр хуулаад жинхэнэ утгуудаа бичнэ: cp .env.example .env
# .env файл git-д ОРОХГҮЙ (нууц мэдээлэлтэй).

# PostgreSQL холболт: postgresql://ХЭРЭГЛЭГЧ:НУУЦ_ҮГ@ХОСТ:ПОРТ/САН
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/travel

# Frontend-ийн хаягууд (таслалаар тусгаарлана). Зөвхөн эдгээр хаягаас API дуудаж болно.
ALLOWED_ORIGINS=https://your-frontend.example.com

# ML загварын файлын зам (Prompt 6-д ачаална, одоохондоо зөвхөн уншина)
MODEL_PATH=models/demand_model.joblib

# Токен гарын үсэг зурах нууц түлхүүр (урт, санамсаргүй). Үүсгэх:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME
# Токен хэдэн минут хүчинтэй байх
JWT_EXPIRE_MINUTES=60
